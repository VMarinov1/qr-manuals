BIND_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://data/app.db
UPLOAD_DIR=data/uploads
STATIC_DIR=static
# Адресът, към който сочат линковете и QR кодовете
PUBLIC_BASE_URL=http://localhost:8080
MAX_UPLOAD_MB=20
# true, когато приложението е зад nginx/Caddy и той добавя X-Forwarded-For.
# Без proxy остави false, иначе клиентът може да подменя IP адреса си.
TRUST_PROXY=false
RUST_LOG=qr_manuals=info,tower_http=info
