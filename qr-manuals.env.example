# Копирай като qr-manuals.env (той не влиза в git).
# Пътищата (база, файлове) и портът са зададени в Dockerfile и не се променят тук.

# Адресът, към който сочат линковете и QR кодовете, без / накрая.
# ВНИМАНИЕ: влиза в отпечатаните QR кодове. Трябва да е окончателен преди първия печат.
PUBLIC_BASE_URL=https://qr.dron.bg

# true зад nginx (production). false само ако приложението се отваря директно,
# иначе клиентът може да подменя IP адреса си и да заобиколи ограничението на входа.
TRUST_PROXY=true

# Максимален размер на един качен файл, в MB.
MAX_UPLOAD_MB=20

# Таван на едно качване (всички избрани файлове заедно), в MB. Cloudflare (безплатен план)
# спира заявки над 100 MB, затова е 95. Проверява се и в браузъра преди изпращане.
MAX_REQUEST_MB=95

RUST_LOG=qr_manuals=info,tower_http=warn
